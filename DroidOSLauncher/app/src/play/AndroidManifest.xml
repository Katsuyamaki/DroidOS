<?xml version="1.0" encoding="utf-8"?>
<!-- The AccessibilityService is system-bound and is not started as an FGS in the Play build.
     Keep the specialUse declaration out of the merged Play release manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />
    <application>
        <service
            android:name=".FloatingLauncherService"
            tools:remove="android:foregroundServiceType">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                tools:node="remove" />
        </service>
    </application>
</manifest>
